{
  "app": {
    // Signing is machine-local. Do not commit real material (paths/passwords).
    // Configure in DevEco (File → Project Structure → Signing Configs) or restore
    // your private backup into this file locally (never push secrets).
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // Set to your local signingConfigs[].name after configuring signing.
        // "signingConfig": "default",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          },
          "nativeCompiler": "BiSheng"
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "mediaservice",
      "srcPath": "./mediaservice",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "youtube_core",
      "srcPath": "./youtube_core"
    },
    {
      "name": "libmdk_napi",
      "srcPath": "./libmdk_napi",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
