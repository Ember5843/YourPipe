{
  "app": {
    // Signing is machine-local. Do NOT commit real material (paths/passwords).
    // Run tools/restore-signing.sh to overlay signing-backup/build-profile.local.json5
    // (git-ignored, per-machine) before local builds, and tools/strip-signing.sh
    // afterwards. DevEco users can also configure signing via
    // File → Project Structure → Signing Configs (writes here — never commit that).
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // Set by restore-signing.sh from your local signingConfigs[].name.
        // "signingConfig": "default",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          },
          "nativeCompiler": "BiSheng"
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "mediaservice",
      "srcPath": "./mediaservice",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "youtube_core",
      "srcPath": "./youtube_core"
    },
    {
      "name": "libmdk_napi",
      "srcPath": "./libmdk_napi",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
