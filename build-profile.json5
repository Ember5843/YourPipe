{
  "app": {
    "signingConfigs": [
      {
        "name": "yourpiperelease",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "YOUR_KEYS_DIR/yourpiperelease.p12",
          "storePassword": "***REMOVED***",
          "keyAlias": "yourpiperelease",
          "keyPassword": "***REMOVED***",
          "signAlg": "SHA256withECDSA",
          "profile": "YOUR_KEYS_DIR/yourpipereleaseRelease.p7b",
          "certpath": "YOUR_KEYS_DIR/yourpiperelease.cer"
        }
      },
      {
        "name": "pc",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "YOUR_KEYS_DIR/yourpipedebug.p12",
          "storePassword": "***REMOVED***",
          "keyAlias": "yourpipedebug",
          "keyPassword": "***REMOVED***",
          "signAlg": "SHA256withECDSA",
          "profile": "YOUR_KEYS_DIR/yourpipedebugDebug.p7b",
          "certpath": "YOUR_KEYS_DIR/yourpipedebug.cer"
        }
      },
      {
        "name": "macos",
        "type": "HarmonyOS",
        "material": {
          "certpath": "~/.ohos/config/macos_YourPipe_j40ZeE6lNThwkGVvbHWuokqDzZkw_dmJjrgbG3eDbdo=.cer",
          "keyAlias": "debugKey",
          "keyPassword": "***REMOVED***",
          "profile": "~/.ohos/config/macos_YourPipe_j40ZeE6lNThwkGVvbHWuokqDzZkw_dmJjrgbG3eDbdo=.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "~/.ohos/config/macos_YourPipe_j40ZeE6lNThwkGVvbHWuokqDzZkw_dmJjrgbG3eDbdo=.p12",
          "storePassword": "***REMOVED***"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "pc",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          },
          "nativeCompiler": "BiSheng"
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "mediaservice",
      "srcPath": "./mediaservice",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "youtube_core",
      "srcPath": "./youtube_core"
    },
    {
      "name": "libmdk_napi",
      "srcPath": "./libmdk_napi",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
