{
  "app": {
    // Template for the git-ignored, machine-local build-profile.json5.
    // Fresh clone: cp build-profile.template.json5 build-profile.json5.
    // Signing is machine-local — do NOT put real material (paths/passwords)
    // in this committed template. Run tools/restore-signing.sh to overlay
    // signing-backup/build-profile.local.json5 (git-ignored, per-machine)
    // before local builds. DevEco users can also configure signing via
    // File → Project Structure → Signing Configs (writes to the local file).
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // Set in your local build-profile.json5 (e.g. by restore-signing.sh).
        // "signingConfig": "default",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          },
          "nativeCompiler": "BiSheng"
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "mediaservice",
      "srcPath": "./mediaservice",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "youtube_core",
      "srcPath": "./youtube_core"
    },
    {
      "name": "libmpv_napi",
      "srcPath": "./libmpv_napi",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
