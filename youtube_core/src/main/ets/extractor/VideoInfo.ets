import { PlayerResponse } from './PlayerResponseTypes';
import { StreamInfo } from './StreamInfo';

/**
 * 推荐视频简要信息（对标 PipePipe compactVideoRenderer）
 */
export class RelatedVideoInfo {
  videoId: string;
  title: string;
  author: string;
  channelId?: string;
  thumbnailUrl?: string;
  lengthSeconds?: number;
  viewCount?: number;
  /** 播放数原始文本（如 "1,234,567 views" / 缩写），卡片展示用 */
  viewCountText?: string;
  /** 相对发布时间文本（compactVideoRenderer.publishedTimeText） */
  publishedTimeText?: string;
  isLive?: boolean;

  constructor(videoId: string, title: string, author: string) {
    this.videoId = videoId;
    this.title = title;
    this.author = author;
  }
}

/**
 * 字幕轨道信息
 * 参照 NewPipe SubtitlesStream
 */
export class SubtitleTrack {
  url: string;
  languageCode: string;
  name: string;
  kind?: string;
  isAutoGenerated: boolean;
  isTranslatable: boolean;

  constructor(url: string, languageCode: string, name: string, kind?: string, isAutoGenerated?: boolean, isTranslatable?: boolean) {
    this.url = url;
    this.languageCode = languageCode;
    this.name = name;
    this.kind = kind;
    this.isAutoGenerated = isAutoGenerated ?? false;
    this.isTranslatable = isTranslatable ?? false;
  }
}

/**
 * 视频缩略图信息
 * 对应 Python: thumbs = ((vd.get("thumbnail") or {}).get("thumbnails")) or []
 */
export class ThumbnailInfo {
  url: string;
  width?: number;
  height?: number;

  constructor(url: string, width?: number, height?: number) {
    this.url = url;
    this.width = width;
    this.height = height;
  }
}

/**
 * 视频章节信息
 * 对应 Python: chapters = player_response.get("chapters") or []
 */
export class ChapterInfo {
  title: string;
  startTimeSeconds: number;

  constructor(title: string, startTimeSeconds: number) {
    this.title = title;
    this.startTimeSeconds = startTimeSeconds;
  }
}

/**
 * 视频信息数据类
 * 对应 Python: extract_metadata() 返回值
 */
export class VideoInfo {
  // 基本元数据
  videoId: string;
  title?: string;
  author?: string;
  channelId?: string;
  lengthSeconds?: number;
  durationMs?: number;
  isLive?: boolean;
  viewCount?: number;
  publishDate?: string;
  uploadDate?: string;
  category?: string;
  description?: string;
  tags: string[];

  // 缩略图
  thumbnails: ThumbnailInfo[];

  // 故事板（用于预览）
  storyboardSpec?: string;

  // 章节
  chapters: ChapterInfo[];

  // 原始播放器响应（保留用于后续处理）
  playerResponse?: PlayerResponse;

  // 解密后的流信息列表
  streams: StreamInfo[];

  // Manifest URLs (deobfuscated, for live/DASH playback)
  hlsUrl?: string;
  dashMpdUrl?: string;

  // 字幕轨道列表（参照 NewPipe，播放时按需下载）
  subtitleTracks: SubtitleTrack[];

  // 内容限制标志
  isAgeRestricted?: boolean;
  isPaidContent?: boolean;
  requiresLogin?: boolean;

  // 点赞/点踩数（对标 PipePipe getLikeCount/getDislikeCount）
  likeCount?: number;
  dislikeCount?: number;

  // 上传者详细信息（对标 PipePipe getUploaderUrl/getUploaderAvatarUrl/getUploaderSubscriberCount）
  uploaderUrl?: string;
  uploaderAvatarUrl?: string;
  uploaderSubscriberCount?: number;

  // 推荐视频（对标 PipePipe getRelatedItems）
  relatedItems: RelatedVideoInfo[];

  constructor(videoId: string) {
    this.videoId = videoId;
    this.tags = [];
    this.thumbnails = [];
    this.chapters = [];
    this.streams = [];
    this.subtitleTracks = [];
    this.relatedItems = [];
  }

  /**
   * 获取最佳缩略图（最高分辨率）
   */
  getBestThumbnail(): ThumbnailInfo | undefined {
    if (this.thumbnails.length === 0) {
      return undefined;
    }
    // 按分辨率排序，返回最高的（拷贝后排序，getter 不得修改原数组）
    return this.thumbnails.slice().sort((a, b) => {
      const areaA = (a.width || 0) * (a.height || 0);
      const areaB = (b.width || 0) * (b.height || 0);
      return areaB - areaA;
    })[0];
  }

  /**
   * 格式化时长为 mm:ss 或 hh:mm:ss
   */
  getFormattedDuration(): string {
    if (!this.lengthSeconds) {
      return "00:00";
    }

    const hours = Math.floor(this.lengthSeconds / 3600);
    const minutes = Math.floor((this.lengthSeconds % 3600) / 60);
    const seconds = this.lengthSeconds % 60;

    if (hours > 0) {
      return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
    } else {
      return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
    }
  }

  /**
   * 格式化观看次数
   */
  getFormattedViewCount(): string {
    if (!this.viewCount) {
      return "0";
    }

    if (this.viewCount >= 1000000000) {
      return (this.viewCount / 1000000000).toFixed(1) + "B";
    } else if (this.viewCount >= 1000000) {
      return (this.viewCount / 1000000).toFixed(1) + "M";
    } else if (this.viewCount >= 1000) {
      return (this.viewCount / 1000).toFixed(1) + "K";
    } else {
      return this.viewCount.toString();
    }
  }
}
