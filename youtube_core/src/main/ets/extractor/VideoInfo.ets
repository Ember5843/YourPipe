/**
 * 推荐视频简要信息（对标 PipePipe compactVideoRenderer）
 */
export class RelatedVideoInfo {
  videoId: string;
  title: string;
  author: string;
  channelId?: string;
  thumbnailUrl?: string;
  lengthSeconds?: number;
  viewCount?: number;
  /** 播放数原始文本（如 "1,234,567 views" / 缩写），卡片展示用 */
  viewCountText?: string;
  /** 相对发布时间文本（compactVideoRenderer.publishedTimeText） */
  publishedTimeText?: string;
  isLive?: boolean;

  constructor(videoId: string, title: string, author: string) {
    this.videoId = videoId;
    this.title = title;
    this.author = author;
  }
}

/**
 * 字幕轨道信息
 * 参照 NewPipe SubtitlesStream
 */
export class SubtitleTrack {
  url: string;
  languageCode: string;
  name: string;
  kind?: string;
  isAutoGenerated: boolean;
  isTranslatable: boolean;
  /** 服务端机器翻译（tlang）虚拟轨标记，由 SubtitleTranslate.buildAutoTranslatedTrack 构造 */
  isAutoTranslated: boolean = false;
  /** 是否为 playerCaptionsTracklistRenderer.audioTracks[].defaultCaptionTrackIndex 指向的默认轨 */
  isDefault: boolean = false;
  /** 原始 vssId（如 ".en"、"a.en"），供 original 原声选轨策略识别 */
  vssId?: string;

  constructor(url: string, languageCode: string, name: string, kind?: string, isAutoGenerated?: boolean, isTranslatable?: boolean) {
    this.url = url;
    this.languageCode = languageCode;
    this.name = name;
    this.kind = kind;
    this.isAutoGenerated = isAutoGenerated ?? false;
    this.isTranslatable = isTranslatable ?? false;
  }
}

/**
 * 视频缩略图信息
 * 对应 Python: thumbs = ((vd.get("thumbnail") or {}).get("thumbnails")) or []
 */
export class ThumbnailInfo {
  url: string;
  width?: number;
  height?: number;

  constructor(url: string, width?: number, height?: number) {
    this.url = url;
    this.width = width;
    this.height = height;
  }
}

/**
 * 故事板单个分辨率层级（解析自 playerStoryboardSpecRenderer / playerLiveStoryboardSpecRenderer）
 */
export interface StoryboardLevel {
  /** 含 $M 占位符的雪碧图 URL 模板（已替换 $L / $N 并拼接 sigh） */
  urlTemplate: string;
  frameWidth: number;
  frameHeight: number;
  totalFrames: number;
  cols: number;
  rows: number;
  intervalMs: number;
}

/**
 * 解析后的故事板元数据（默认选中最接近 160x90 的层级）
 */
export interface StoryboardInfo {
  urlTemplate: string;
  frameWidth: number;
  frameHeight: number;
  totalFrames: number;
  cols: number;
  rows: number;
  intervalMs: number;
  isLive: boolean;
  levels: StoryboardLevel[];
}

/**
 * 指定时间点对应的故事板雪碧图切片位置
 */
export interface StoryboardFrame {
  sheetUrl: string;
  col: number;
  row: number;
  cols: number;
  rows: number;
  frameWidth: number;
  frameHeight: number;
  sheetIndex: number;
  frameIndex: number;
}

/**
 * Most Replayed 热力图采样点（intensity 已归一化至 0..1）
 */
export interface HeatmapPoint {
  startSec: number;
  durationSec: number;
  intensity: number;
}

function normalizeStoryboardUrl(rawUrl: string): string {
  const trimmed = rawUrl.trim();
  if (trimmed.length === 0) {
    return '';
  }
  if (trimmed.startsWith('//')) {
    return `https:${trimmed}`;
  }
  if (trimmed.startsWith('http://')) {
    return `https://${trimmed.substring(7)}`;
  }
  if (trimmed.startsWith('https://')) {
    return trimmed;
  }
  return '';
}

function storyboardDistanceToTarget(level: StoryboardLevel): number {
  const longSide = Math.max(level.frameWidth, level.frameHeight);
  const shortSide = Math.min(level.frameWidth, level.frameHeight);
  return Math.abs(longSide - 160) + Math.abs(shortSide - 90);
}

/**
 * 解析 YouTube 故事板 spec 字符串。
 * 支持标准 VOD 格式 `baseUrl|w#h#count#cols#rows#intervalMs#name#sigh|...`
 * 与直播简化格式 `baseUrl#w#h#cols#rows[#intervalMs]`。
 */
export function parseStoryboardSpec(
  spec: string,
  durationSec: number,
  isLive: boolean = false
): StoryboardInfo | undefined {
  if (!spec) {
    return undefined;
  }
  const trimmed = spec.trim();
  if (trimmed.length === 0) {
    return undefined;
  }

  const levels: StoryboardLevel[] = [];

  if (trimmed.includes('|')) {
    const parts: string[] = trimmed.split('|');
    if (parts.length < 2) {
      return undefined;
    }
    const baseUrl = normalizeStoryboardUrl(parts[0]);
    if (baseUrl.length === 0) {
      return undefined;
    }
    for (let levelIdx = 0; levelIdx < parts.length - 1; levelIdx++) {
      const fields: string[] = parts[levelIdx + 1].split('#');
      if (fields.length < 8) {
        continue;
      }
      const frameWidth = parseInt(fields[0], 10);
      const frameHeight = parseInt(fields[1], 10);
      const parsedCount = parseInt(fields[2], 10);
      const cols = parseInt(fields[3], 10);
      const rows = parseInt(fields[4], 10);
      let intervalMs = parseInt(fields[5], 10);
      const name = fields[6] || '';
      const sigh = fields[7] || '';

      if (!Number.isFinite(frameWidth) || frameWidth <= 0 || !Number.isFinite(frameHeight) || frameHeight <= 0) {
        continue;
      }
      if (!Number.isFinite(cols) || cols <= 0 || !Number.isFinite(rows) || rows <= 0) {
        continue;
      }
      const validCount = Number.isFinite(parsedCount) && parsedCount > 0 ? parsedCount : 0;
      if (!Number.isFinite(intervalMs) || intervalMs <= 0) {
        if (durationSec > 0 && validCount > 0) {
          intervalMs = Math.max(100, Math.round((durationSec * 1000) / validCount));
        } else {
          continue;
        }
      }
      const totalFrames = validCount > 0
        ? validCount
        : (durationSec > 0 ? Math.max(1, Math.ceil((durationSec * 1000) / intervalMs)) : 0);

      let urlTemplate = baseUrl.split('$L').join(String(levelIdx));
      if (name.length > 0) {
        urlTemplate = urlTemplate.split('$N').join(name);
      }
      if (sigh.length > 0 && !urlTemplate.includes('sigh=')) {
        const sep = urlTemplate.includes('?') ? '&' : '?';
        urlTemplate = `${urlTemplate}${sep}sigh=${sigh}`;
      }

      levels.push({
        urlTemplate: urlTemplate,
        frameWidth: frameWidth,
        frameHeight: frameHeight,
        totalFrames: totalFrames,
        cols: cols,
        rows: rows,
        intervalMs: intervalMs
      });
    }
  } else if (trimmed.includes('#')) {
    // 直播故事板格式：baseUrl#w#h#cols#rows[#intervalMs]
    const fields: string[] = trimmed.split('#');
    if (fields.length >= 5) {
      const baseUrl = normalizeStoryboardUrl(fields[0]);
      const frameWidth = parseInt(fields[1], 10);
      const frameHeight = parseInt(fields[2], 10);
      const cols = parseInt(fields[3], 10);
      const rows = parseInt(fields[4], 10);
      if (baseUrl.length > 0
        && Number.isFinite(frameWidth) && frameWidth > 0
        && Number.isFinite(frameHeight) && frameHeight > 0
        && Number.isFinite(cols) && cols > 0
        && Number.isFinite(rows) && rows > 0) {
        let intervalMs = fields.length >= 6 ? parseInt(fields[5], 10) : 0;
        if (!Number.isFinite(intervalMs) || intervalMs <= 0) {
          intervalMs = 5000;
        }
        const totalFrames = durationSec > 0 ? Math.max(1, Math.ceil((durationSec * 1000) / intervalMs)) : 0;
        levels.push({
          urlTemplate: baseUrl,
          frameWidth: frameWidth,
          frameHeight: frameHeight,
          totalFrames: totalFrames,
          cols: cols,
          rows: rows,
          intervalMs: intervalMs
        });
      }
    }
  }

  if (levels.length === 0) {
    return undefined;
  }

  let best: StoryboardLevel = levels[0];
  let bestDist: number = storyboardDistanceToTarget(best);
  for (let i = 1; i < levels.length; i++) {
    const candidate = levels[i];
    const dist = storyboardDistanceToTarget(candidate);
    if (dist < bestDist || (dist === bestDist && candidate.frameWidth > best.frameWidth)) {
      best = candidate;
      bestDist = dist;
    }
  }

  return {
    urlTemplate: best.urlTemplate,
    frameWidth: best.frameWidth,
    frameHeight: best.frameHeight,
    totalFrames: best.totalFrames,
    cols: best.cols,
    rows: best.rows,
    intervalMs: best.intervalMs,
    isLive: isLive,
    levels: levels
  };
}

/**
 * 纯函数：根据视频秒数计算故事板雪碧图 URL 与目标帧在网格中的行列位置。
 */
export function getStoryboardFrame(
  info: StoryboardInfo | undefined,
  sec: number
): StoryboardFrame | undefined {
  if (!info || !info.urlTemplate || info.cols <= 0 || info.rows <= 0
    || info.intervalMs <= 0 || info.frameWidth <= 0 || info.frameHeight <= 0) {
    return undefined;
  }
  const safeSec = Number.isFinite(sec) && sec > 0 ? sec : 0;
  let frameIndex = Math.floor((safeSec * 1000) / info.intervalMs);
  if (info.totalFrames > 0 && frameIndex >= info.totalFrames) {
    frameIndex = info.totalFrames - 1;
  }
  if (frameIndex < 0) {
    frameIndex = 0;
  }
  const framesPerSheet = info.cols * info.rows;
  const sheetIndex = Math.floor(frameIndex / framesPerSheet);
  const indexInSheet = frameIndex % framesPerSheet;
  const row = Math.floor(indexInSheet / info.cols);
  const col = indexInSheet % info.cols;
  const sheetUrl = info.urlTemplate.split('$M').join(String(sheetIndex));
  return {
    sheetUrl: sheetUrl,
    col: col,
    row: row,
    cols: info.cols,
    rows: info.rows,
    frameWidth: info.frameWidth,
    frameHeight: info.frameHeight,
    sheetIndex: sheetIndex,
    frameIndex: frameIndex
  };
}

/**
 * 将热力图采样点规范化（intensity 限幅 0..1）并在点数超出 maxBuckets 时按桶取峰值降采样。
 */
export function downsampleHeatmap(points: HeatmapPoint[], maxBuckets: number = 100): HeatmapPoint[] {
  if (!points || points.length === 0) {
    return [];
  }
  const limit = maxBuckets > 0 ? Math.floor(maxBuckets) : 100;
  if (points.length <= limit) {
    const out: HeatmapPoint[] = [];
    for (let i = 0; i < points.length; i++) {
      const p = points[i];
      out.push({
        startSec: p.startSec >= 0 && Number.isFinite(p.startSec) ? p.startSec : 0,
        durationSec: p.durationSec >= 0 && Number.isFinite(p.durationSec) ? p.durationSec : 0,
        intensity: Math.max(0, Math.min(1, Number.isFinite(p.intensity) ? p.intensity : 0))
      });
    }
    return out;
  }

  const downsampled: HeatmapPoint[] = [];
  const total = points.length;
  for (let b = 0; b < limit; b++) {
    const startIdx = Math.floor((b * total) / limit);
    const rawEndIdx = Math.floor(((b + 1) * total) / limit);
    const endIdx = Math.min(total, Math.max(startIdx + 1, rawEndIdx));
    const first = points[startIdx];
    const last = points[endIdx - 1];
    let peak = 0;
    for (let i = startIdx; i < endIdx; i++) {
      const rawIntensity = Number.isFinite(points[i].intensity) ? points[i].intensity : 0;
      const clamped = Math.max(0, Math.min(1, rawIntensity));
      if (clamped > peak) {
        peak = clamped;
      }
    }
    const startSec = first.startSec >= 0 && Number.isFinite(first.startSec) ? first.startSec : 0;
    const lastStart = last.startSec >= 0 && Number.isFinite(last.startSec) ? last.startSec : startSec;
    const lastDur = last.durationSec >= 0 && Number.isFinite(last.durationSec) ? last.durationSec : 0;
    const durationSec = Math.max(0, (lastStart + lastDur) - startSec);
    downsampled.push({
      startSec: startSec,
      durationSec: durationSec,
      intensity: peak
    });
  }
  return downsampled;
}

/**
 * 视频章节信息
 * 对应 Python: chapters = player_response.get("chapters") or []
 */
export class ChapterInfo {
  title: string;
  startTimeSeconds: number;
  thumbnailUrl?: string;

  constructor(title: string, startTimeSeconds: number, thumbnailUrl?: string) {
    this.title = title;
    this.startTimeSeconds = startTimeSeconds;
    this.thumbnailUrl = thumbnailUrl;
  }
}

/**
 * 视频信息数据类
 * 对应 Python: extract_metadata() 返回值
 */
export class VideoInfo {
  // 基本元数据
  videoId: string;
  title?: string;
  author?: string;
  channelId?: string;
  lengthSeconds?: number;
  durationMs?: number;  isLiveReplay?: boolean;
  isLive?: boolean;
  viewCount?: number;
  publishDate?: string;
  uploadDate?: string;
  category?: string;
  description?: string;
  tags: string[];

  // 缩略图
  thumbnails: ThumbnailInfo[];

  // 故事板（用于预览）
  storyboardSpec?: string;
  storyboard?: StoryboardInfo;

  // Most Replayed 热力图
  heatmap?: HeatmapPoint[];

  // 章节
  chapters: ChapterInfo[];

  // 原始播放器响应（保留用于后续处理）
  playerResponse?: PlayerResponse;

  // 解密后的流信息列表
  streams: StreamInfo[];

  // Manifest URLs (deobfuscated, for live/DASH playback)
  hlsUrl?: string;
  dashMpdUrl?: string;

  // 字幕轨道列表（参照 NewPipe，播放时按需下载）
  subtitleTracks: SubtitleTrack[];
  /** playerCaptionsTracklistRenderer.audioTracks[].defaultCaptionTrackIndex 映射后的有效索引 */
  defaultCaptionTrackIndex?: number;

  // 内容限制标志
  isAgeRestricted?: boolean;
  isPaidContent?: boolean;
  requiresLogin?: boolean;

  // 点赞/点踩数（对标 PipePipe getLikeCount/getDislikeCount）
  likeCount?: number;
  dislikeCount?: number;

  // 上传者详细信息（对标 PipePipe getUploaderUrl/getUploaderAvatarUrl/getUploaderSubscriberCount）
  uploaderUrl?: string;
  uploaderAvatarUrl?: string;
  uploaderSubscriberCount?: number;

  // 推荐视频（对标 PipePipe getRelatedItems）
  relatedItems: RelatedVideoInfo[];

  constructor(videoId: string) {
    this.videoId = videoId;
    this.tags = [];
    this.thumbnails = [];
    this.chapters = [];
    this.streams = [];
    this.subtitleTracks = [];
    this.relatedItems = [];
  }

  /**
   * 获取最佳缩略图（最高分辨率）
   */
  getBestThumbnail(): ThumbnailInfo | undefined {
    if (this.thumbnails.length === 0) {
      return undefined;
    }
    // 按分辨率排序，返回最高的（拷贝后排序，getter 不得修改原数组）
    return this.thumbnails.slice().sort((a, b) => {
      const areaA = (a.width || 0) * (a.height || 0);
      const areaB = (b.width || 0) * (b.height || 0);
      return areaB - areaA;
    })[0];
  }

  /**
   * 格式化时长为 mm:ss 或 hh:mm:ss
   */
  getFormattedDuration(): string {
    if (!this.lengthSeconds) {
      return "00:00";
    }

    const hours = Math.floor(this.lengthSeconds / 3600);
    const minutes = Math.floor((this.lengthSeconds % 3600) / 60);
    const seconds = this.lengthSeconds % 60;

    if (hours > 0) {
      return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
    } else {
      return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
    }
  }

  /**
   * 格式化观看次数
   */
  getFormattedViewCount(): string {
    if (!this.viewCount) {
      return "0";
    }

    if (this.viewCount >= 1000000000) {
      return (this.viewCount / 1000000000).toFixed(1) + "B";
    } else if (this.viewCount >= 1000000) {
      return (this.viewCount / 1000000).toFixed(1) + "M";
    } else if (this.viewCount >= 1000) {
      return (this.viewCount / 1000).toFixed(1) + "K";
    } else {
      return this.viewCount.toString();
    }
  }
}
